<?xml version="1.0" encoding="utf-8"?>
<!-- Blokkoló képernyő: fejlécsáv + tartalom; a sorok között egyforma, a képernyő magasságához igazodó térköz -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Élő, animált háttér -->
    <com.example.socialblock.AnimatedBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fejlécsáv -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:minHeight="60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@drawable/socialock_logo"
            android:contentDescription="@string/brand_name"
            android:layout_width="30dp"
            android:layout_height="30dp" />

        <TextView
            android:text="@string/block_status_prefix"
            android:textColor="@color/text_primary"
            android:textSize="15dp"
            android:layout_marginStart="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="@string/block_status_active"
            android:textColor="@color/danger"
            android:textSize="11dp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/bg_status_on"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginStart="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/buttonMenu"
            android:src="@drawable/ic_menu_dots"
            android:contentDescription="@string/menu_title"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_marginEnd="0dp"
            android:layout_width="34dp"
            android:layout_height="34dp" />
    </LinearLayout>

    <!-- Tartalom -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- A megnyitni próbált app gyári ikonja, önmagában -->
        <ImageView
            android:id="@+id/imageBlockedApp"
            android:contentDescription="@null"
            android:layout_width="97dp"
            android:layout_height="97dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:text="@string/block_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textBlockedApp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:text="@string/block_hint"
            android:textColor="#059669"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center"
            android:background="@drawable/bg_card_glass"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textUnlocksRemaining"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeStepGranularity="0.5sp"
            android:gravity="center"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:lineSpacingMultiplier="1.2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonGoHome"
            android:text="@string/go_home"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:minHeight="56dp"
            android:elevation="10dp"
            android:outlineSpotShadowColor="#2D65F8"
            android:outlineAmbientShadowColor="#2D65F8"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_button_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonRequestUnlock"
            android:text="@string/request_unlock"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/text_button_outline"
            android:minHeight="52dp"
            android:stateListAnimator="@null"
            android:background="@drawable/bg_button_outline"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:text="@string/footer_copyright"
            android:textColor="#6B7280"
            android:textSize="11sp"
            android:alpha="0.7"
            android:gravity="center"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>

</FrameLayout>
