<?xml version="1.0" encoding="utf-8"?>
<!-- SociaLock főképernyő (v1.4): élő háttér, fejlécsáv, neon üvegkártyák -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.example.socialblock.AnimatedBackgroundView
        android:tag="main"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <!-- Fejlécsáv -->
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/bg_header" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:minHeight="60dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:src="@drawable/socialock_logo" android:contentDescription="@string/brand_name"
                android:layout_width="32dp" android:layout_height="32dp" />
            <TextView android:text="@string/block_status_prefix" android:textColor="@color/text_primary" android:textSize="15sp"
                android:layout_marginStart="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/textHeaderStatus" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:id="@+id/buttonMenu" android:src="@drawable/ic_menu_dots" android:contentDescription="@string/menu_title"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="6dp"
                android:layout_marginStart="8dp" android:layout_marginEnd="-6dp"
                android:layout_width="36dp" android:layout_height="36dp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/contentContainer" android:orientation="vertical"
                android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="8dp" android:paddingBottom="32dp"
                android:clipToPadding="false" android:clipChildren="false"
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <!-- Hős blokk -->
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <ImageView android:id="@+id/imageHeroLogo" android:src="@drawable/socialock_logo" android:contentDescription="@null"
                        android:layout_width="72dp" android:layout_height="72dp" />
                    <LinearLayout android:orientation="vertical" android:layout_marginStart="14dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                        <TextView android:id="@+id/textHeroVersion" android:text="@string/app_version_label" android:textColor="@color/accent"
                            android:textSize="12sp" android:letterSpacing="0.25" android:fontFamily="monospace"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/textHeroTitle" android:text="@string/brand_name" android:textColor="@color/text_primary"
                            android:textSize="34sp" android:textStyle="bold" android:letterSpacing="-0.01" android:includeFontPadding="false"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/textHeroSubtitle" android:text="@string/app_subtitle" android:textColor="@color/text_primary"
                            android:textSize="13sp" android:alpha="0.85" android:maxLines="1" android:layout_marginTop="2dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardPermissions"
                android:background="@drawable/bg_card_neon"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                android:outlineSpotShadowColor="#2D65F8"
                
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/badgePerm" android:text="1" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_badge"
                        android:layout_width="28dp" android:layout_height="28dp" />
                    <TextView android:text="@string/setup_permissions_title_v14" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.01"
                        android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowAccessibility" android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonGrantAccessibility"
                        android:text="@string/grant_accessibility" android:textAllCaps="false" android:textSize="15sp"
                        android:textColor="@color/text_button_outline" android:background="@drawable/bg_button_outline"
                        android:stateListAnimator="@null" android:minHeight="48dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/checkAccessibility" android:text="@string/permission_granted_full"
                        android:textColor="@color/accent" android:textSize="15sp" android:visibility="gone"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowUsage" android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonGrantUsageAccess"
                        android:text="@string/grant_usage_access" android:textAllCaps="false" android:textSize="15sp"
                        android:textColor="@color/text_button_outline" android:background="@drawable/bg_button_outline"
                        android:stateListAnimator="@null" android:minHeight="48dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/checkUsage" android:text="@string/permission_granted_full"
                        android:textColor="@color/accent" android:textSize="15sp" android:visibility="gone"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowOverlay" android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonGrantOverlay"
                        android:text="@string/grant_overlay" android:textAllCaps="false" android:textSize="15sp"
                        android:textColor="@color/text_button_outline" android:background="@drawable/bg_button_outline"
                        android:stateListAnimator="@null" android:minHeight="48dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/checkOverlay" android:text="@string/permission_granted_full"
                        android:textColor="@color/accent" android:textSize="15sp" android:visibility="gone"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:id="@+id/rowDeviceAdmin" android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonEnableDeviceAdmin"
                        android:text="@string/enable_device_admin" android:textAllCaps="false" android:textSize="15sp"
                        android:textColor="@color/text_button_outline" android:background="@drawable/bg_button_outline"
                        android:stateListAnimator="@null" android:minHeight="48dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/checkDeviceAdmin" android:text="@string/permission_granted_full"
                        android:textColor="@color/accent" android:textSize="15sp" android:visibility="gone"
                        android:paddingTop="10dp" android:paddingBottom="10dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_neon"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                android:outlineSpotShadowColor="#2D65F8"
                
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/badgeSchedule" android:text="2" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_badge"
                        android:layout_width="28dp" android:layout_height="28dp" />
                    <TextView android:text="@string/schedule_title_v14" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.01"
                        android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:text="@string/blocking_enabled_label" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchBlockingEnabled"
                        app:thumbTint="@color/switch_thumb" app:trackTint="@color/switch_track"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                
                <TextView android:text="@string/schedule_start_label" android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <EditText android:id="@+id/inputStartHour" android:hint="@string/start_hour"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="number"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:gravity="center" android:maxLength="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text=":" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold"
                        android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText android:id="@+id/inputStartMinute" android:hint="@string/start_minute"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="number"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:gravity="center" android:maxLength="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>
                
                <TextView android:text="@string/schedule_end_label" android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <EditText android:id="@+id/inputEndHour" android:hint="@string/end_hour"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="number"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:gravity="center" android:maxLength="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                    <TextView android:text=":" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold"
                        android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText android:id="@+id/inputEndMinute" android:hint="@string/end_minute"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="number"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:gravity="center" android:maxLength="2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonSaveSchedule"
                    android:text="@string/save_schedule" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:background="@drawable/bg_button_gradient"
                    android:stateListAnimator="@null" android:minHeight="52dp" android:elevation="8dp"
                    android:outlineSpotShadowColor="#2D65F8" android:outlineAmbientShadowColor="#2D65F8"
                    android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/textSaveConfirmation" android:text="@string/schedule_saved"
                    android:textColor="@color/accent" android:visibility="gone" android:layout_marginTop="8dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_neon"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                android:outlineSpotShadowColor="#2D65F8"
                
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/badgeHelper" android:text="3" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_badge"
                        android:layout_width="28dp" android:layout_height="28dp" />
                    <TextView android:text="@string/helper_title_v14" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.01"
                        android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView android:text="@string/helper_info" android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
                <RadioGroup android:id="@+id/radioHelper" android:orientation="vertical" android:layout_marginTop="8dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/radioHelperYes" android:text="@string/helper_yes" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:buttonTint="@color/accent"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/radioHelperNo" android:text="@string/helper_no" android:textColor="@color/text_primary"
                        android:textSize="16sp" android:buttonTint="@color/accent"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </RadioGroup>
                <EditText android:id="@+id/inputHelperPhone" android:hint="@string/helper_phone_input_hint"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="phone"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/buttonSaveHelper"
                    android:text="@string/helper_save" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:background="@drawable/bg_button_gradient"
                    android:stateListAnimator="@null" android:minHeight="52dp" android:elevation="8dp"
                    android:outlineSpotShadowColor="#2D65F8" android:outlineAmbientShadowColor="#2D65F8"
                    android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/textHelperStatus" android:textColor="@color/text_secondary" android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2" android:layout_marginTop="12dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card_neon"
                android:padding="18dp"
                android:layout_marginTop="16dp"
                android:elevation="6dp"
                android:outlineSpotShadowColor="#2D65F8"
                
                android:layout_width="match_parent" android:layout_height="wrap_content">

                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="14dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/badgeApps" android:text="4" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
                        android:gravity="center" android:background="@drawable/bg_badge"
                        android:layout_width="28dp" android:layout_height="28dp" />
                    <TextView android:text="@string/apps_title_v14" android:textColor="@color/text_primary"
                        android:textStyle="bold" android:textSize="17sp" android:letterSpacing="0.01"
                        android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <EditText android:id="@+id/inputSearchApps" android:hint="@string/search_apps_hint"
                        android:textColor="@color/text_primary" android:textColorHint="#9CA3AF"
                        android:background="@drawable/bg_input_neon" android:inputType="text"
                        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp"
                        android:textSize="16sp" android:drawableStart="@android:drawable/ic_menu_search" android:drawablePadding="10dp" android:maxLines="1" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerApps"
                    android:nestedScrollingEnabled="true"
                    android:layout_width="match_parent" android:layout_height="420dp" />
            </LinearLayout>

                <!-- Lábléc -->
                <View android:background="#E5E7EB" android:layout_marginTop="28dp"
                    android:layout_width="match_parent" android:layout_height="1dp" />
                <TextView android:text="@string/footer_copyright" android:textColor="#6B7280"
                    android:textSize="12sp" android:gravity="center" android:letterSpacing="0.04"
                    android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
