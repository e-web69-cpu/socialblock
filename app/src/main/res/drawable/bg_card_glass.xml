<?xml version="1.0" encoding="utf-8"?>
<!-- Fehér kártya bal oldali zöld jelölősávval -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#E5E7EB" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:gravity="start|center_vertical" android:start="0dp" android:width="4dp" android:top="18dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#10B981" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
