<?xml version="1.0" encoding="utf-8"?>
<!-- Fejlécsáv: sötétebb, áttetsző háttér, alul finom lila vonal -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C6F60F0" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E60B0C1C" android:endColor="#B30F1128" />
        </shape>
    </item>
</layer-list>
