{
  "manifest_version": 3,
  "name": "SociaLock – böngészőmodul",
  "version": "0.1.0",
  "description": "A SociaLock telefonos app tiltási időszakában tiltja a megadott weboldalakat (szinkron: sb.trendz.hu).",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["https://sb.trendz.hu/*", "<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "SociaLock", "default_popup": "popup.html" },
  "web_accessible_resources": [{ "resources": ["blocked.html", "logo.png"], "matches": ["<all_urls>"] }]
}
